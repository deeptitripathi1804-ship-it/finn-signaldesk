# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets.
# ALL OPTIONAL: with no key, FINN runs fully in free extractive mode.

# Option A: Anthropic (cheap = Haiku, strong = Sonnet)
# ANTHROPIC_API_KEY = "sk-ant-..."

# Option B: Gemini free tier
# GEMINI_API_KEY = "..."

# Override model routing if you like
# FINN_MODEL_CHEAP  = "claude-haiku-5-5"
# FINN_MODEL_STRONG = "claude-sonnet-5-5"
